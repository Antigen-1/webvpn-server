#lang racket/base

;; Static checks over the Racket sources: every module provides python, the
;; generated Python only reaches other modules through the pyimports bridge or
;; the project's own modules, and the build metadata is present.

(require json
         racket/file
         rkt-pythonize/builder/project
         rkt-pythonize/builder/render
         rkt-pythonize/builder/pack
         racket/list
         racket/path
         racket/string
         rackunit
         "support.rkt")

(define (python-of path)
  (parameterize ([use-compiled-file-paths '()])
    (dynamic-require `(file ,(path->string path)) 'python)))

(define (imported-modules code)
  (regexp-match* #rx"import_module\\(\"([^\"]+)\"\\)" code #:match-select cadr))

(module+ test
  (test-case "every src/*.rkt provides a Python string"
    (define sources (rkt-sources))
    (check-true (> (length sources) 0))
    (for ([path (in-list sources)])
      (define code (python-of path))
      (check-true (string? code) (path->string path))
      (check-true (string-contains? code "# generated by rkt-pythonize")
                  (path->string path))))

  (test-case "generated modules import only pyimports and program modules"
    (define sources (rkt-sources))
    (define allowed
      (cons "pyimports"
            (for/list ([path (in-list sources)])
              (regexp-replace #rx"\\.rkt$"
                              (path->string (file-name-from-path path))
                              ""))))
    (for ([path (in-list sources)])
      (for ([module (in-list (imported-modules (python-of path)))])
        (check-true (and (member module allowed) #t)
                    (format "~a imports ~a" (path->string path) module)))))

  (test-case "rkt-pythonize/builder reads and renders the project"
    (define temp-root (build-path project-root ".tmp"))
    (make-directory* temp-root)
    (define dest (make-temporary-file "webvpn-build-~a" 'directory temp-root))
    (dynamic-wind
     void
     (lambda ()
       (define project (read-project project-root #:dest (find-relative-path project-root dest)))
       (check-equal? (project-name project) "webvpn-server")
       (check-equal? (project-entry project) "main")
       (render-project project #:quiet? #t)
       (check-true (file-exists? (build-path dest "python/main.py")))
       (check-true (file-exists? (build-path dest "python/pyimports.py")))
       (check-not-false (member "main" (project-modules project)))
       (check-not-false (member "server" (project-modules project)))
       (define arguments (pack-arguments project (build-path dest "python") '() #:quiet? #t))
       (check-not-false (member "--onefile" arguments))
       (check-not-false (member "main" arguments)))
     (lambda () (delete-directory/files dest))))

  (test-case "build.rkt makes one file and names Uvicorn's dynamic modules"
    (define text (file->string (build-path project-root "build.rkt")))
    (check-true (string-contains? text "#:onefile? #t"))
    (check-true (string-contains? text "uvicorn.protocols.http.h11_impl"))
    (check-true (string-contains? text "#:hidden-imports")))

  (test-case "requirements and the example configuration are present"
    (define requirements (file->string (build-path project-root "requirements.txt")))
    (check-true (string-contains? requirements "fastapi=="))
    (check-true (string-contains? requirements "uvicorn=="))
    (define example
      (with-input-from-file (build-path project-root "webvpn.example.json") read-json))
    (check-true (hash? example))
    (check-true (hash-has-key? example 'users))
    (check-true (hash-has-key? example 'targets))))
